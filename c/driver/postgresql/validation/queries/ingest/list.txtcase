    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "bools",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "b",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "ints",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "l",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "strings",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

