<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net472</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <VersionPrefix>$(AdbcCoreVersionPrefix)</VersionPrefix>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProcessArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</ProcessArchitecture>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow.Operations" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="OpenTelemetry" />
    <!-- OpenTelemetry requires 10.0.0; keep the core and listener contract minimum unchanged. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" VersionOverride="10.0.0" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="DuckDB.NET.Bindings.Full" Version="[$(DuckDbVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Apache.Arrow.Adbc\Apache.Arrow.Adbc.csproj" />
    <ProjectReference Include="..\..\src\Client\Apache.Arrow.Adbc.Client.csproj" />
  </ItemGroup>

  <Target Name="CopyDuckDb" AfterTargets="Build">
    <PropertyGroup>
      <DuckDbPackagePath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'duckdb.net.bindings.full', '$(DuckDbVersion)'))</DuckDbPackagePath>
    </PropertyGroup>
    <Copy Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'" SourceFiles="$(DuckDbPackagePath)\runtimes\win-$(ProcessArchitecture)\native\duckdb.dll" DestinationFolder="$(OutputPath)" />
    <Copy Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'" SourceFiles="$(DuckDbPackagePath)\runtimes\linux-$(ProcessArchitecture)\native\libduckdb.so" DestinationFolder="$(OutputPath)" />
    <Copy Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'" SourceFiles="$(DuckDbPackagePath)\runtimes\osx\native\libduckdb.dylib" DestinationFolder="$(OutputPath)" />
  </Target>

</Project>
